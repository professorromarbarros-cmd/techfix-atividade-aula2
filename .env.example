# Copie para ".env" e preencha com os dados do SEU projeto Supabase.
# Project Settings -> Data API (URL) e Project Settings -> API Keys (chave).
# Use a chave anon/public (eyJ...) ou publishable (sb_publishable_...).
# NUNCA use a service_role/secret key (ignora o RLS e o app roda com link público).
SUPABASE_URL=
SUPABASE_KEY=
# true = gera link público temporário (*.gradio.live) para testar no celular
GRADIO_SHARE=true
